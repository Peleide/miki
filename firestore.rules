
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FONCTIONS HELPER ---

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Vérifie si l'utilisateur est un Admin Plateforme
    function isPlatformAdmin() {
      let data = getUserData();
      return (data.tenantsAccess.platform == 'ADMIN') || 
             (data.accessibleTenantIds is list && data.accessibleTenantIds.hasAny(['platform']));
    }

    // Vérifie si l'utilisateur a accès au Tenant demandé
    // CORRECTIF : On vérifie la map tenantsAccess OU la liste accessibleTenantIds (legacy)
    function hasTenantAccess(tenantId) {
      let userData = getUserData();
      return (tenantId in userData.tenantsAccess) || 
             (userData.accessibleTenantIds is list && userData.accessibleTenantIds.hasAny([tenantId])) ||
             isPlatformAdmin();
    }

    // Vérifie si l'utilisateur connecté est Manager ou Admin (peut lire les profils de son équipe)
    function isManagerOrAbove() {
      let data = getUserData();
      return isPlatformAdmin() || data.role in ['MANAGER', 'ADMIN'];
    }

    // --- REGLES DE SECURITE ---

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isManagerOrAbove());
      allow write: if false;

      match /notifications/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /tenants/{tenantId} {
      allow read: if request.auth != null && hasTenantAccess(tenantId);
      allow write: if false;

      match /{document=**} {
        allow read: if request.auth != null && hasTenantAccess(tenantId);
        allow write: if false;
      }

      match /cdilUnits/{unitId} {
        allow read: if request.auth != null && hasTenantAccess(tenantId);
        allow write: if false;
      }

      match /visitSessions/{sessionId} {
        allow read: if request.auth != null && hasTenantAccess(tenantId);
        allow write: if false;
      }
    }

    match /audit_logs/{logId} {
      allow read: if request.auth != null && isPlatformAdmin();
      allow write: if false;
    }
  }
}
