rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FONCTIONS HELPER ---

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Vérifie si l'utilisateur est un Admin Plateforme
    function isPlatformAdmin() {
      let data = getUserData();
      return (data.get('tenantsAccess', {}).get('platform', '') == 'ADMIN') ||
             data.get('accessibleTenantIds', []).hasAny(['platform']);
    }

    // Vérifie si l'utilisateur a accès au Tenant demandé
    // CORRECTIF : On vérifie la map tenantsAccess OU la liste accessibleTenantIds (legacy)
    function hasTenantAccess(tenantId) {
      let userData = getUserData();
      return (tenantId in userData.get('tenantsAccess', {})) ||
             userData.get('accessibleTenantIds', []).hasAny([tenantId]) ||
             isPlatformAdmin();
    }

    // GMAO : un compte client (rattaché à une organisation cliente) ne lit que ce qui concerne ses machines.
    // Les comptes sans gmaoClientIds (toute l'appli historique) gardent exactement les mêmes droits qu'avant.
    function gmaoClientId(tenantId) {
      return getUserData().get('gmaoClientIds', {}).get(tenantId, null);
    }
    function isGmaoClient(tenantId) {
      return gmaoClientId(tenantId) != null && !isPlatformAdmin();
    }
    function isAnyGmaoClient() {
      return getUserData().get('gmaoClientIds', {}).size() > 0 && !isPlatformAdmin();
    }
    function clientMayRead(tenantId, data) {
      return isGmaoClient(tenantId) && data.clientId == gmaoClientId(tenantId);
    }

    // --- REGLES DE SECURITE ---

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || !isAnyGmaoClient());
      allow write: if false;

      match /notifications/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /tenants/{tenantId} {
      allow read: if request.auth != null && hasTenantAccess(tenantId);
      allow write: if false;

      match /{document=**} {
        allow read: if request.auth != null && hasTenantAccess(tenantId) && !isGmaoClient(tenantId);
        allow write: if false;
      }

      // Comptes clients GMAO : uniquement leurs machines et leur historique, plus les référentiels partagés.
      match /gmaoAssets/{id} { allow read: if request.auth != null && hasTenantAccess(tenantId) && clientMayRead(tenantId, resource.data); }
      match /gmaoAssetEvents/{id} { allow read: if request.auth != null && hasTenantAccess(tenantId) && clientMayRead(tenantId, resource.data); }
      match /gmaoRequests/{id} { allow read: if request.auth != null && hasTenantAccess(tenantId) && clientMayRead(tenantId, resource.data); }
      match /gmaoWorkOrders/{id} { allow read: if request.auth != null && hasTenantAccess(tenantId) && clientMayRead(tenantId, resource.data); }
      match /gmaoClients/{id} { allow read: if request.auth != null && hasTenantAccess(tenantId) && isGmaoClient(tenantId) && id == gmaoClientId(tenantId); }
      match /gmaoTypologies/{id} { allow read: if request.auth != null && hasTenantAccess(tenantId); }
      match /checklists/{id} { allow read: if request.auth != null && hasTenantAccess(tenantId); }
      match /sites/{id} { allow read: if request.auth != null && hasTenantAccess(tenantId); }
    }

    // Index des QR codes et limites anti-spam : Cloud Functions uniquement.
    match /gmaoQr/{token} { allow read, write: if false; }
    match /gmaoRateLimits/{key} { allow read, write: if false; }

    match /audit_logs/{logId} {
      allow read: if request.auth != null && isPlatformAdmin();
      allow write: if false;
    }
  }
}
